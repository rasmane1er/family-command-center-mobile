{
  "expo": {
    "name": "Family Command Center",
    "slug": "family-command-center",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F2952"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familycommandcenter.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2952"
      },
      "package": "com.familycommandcenter.app"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Family Command Center to access your photos."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "family-command-center"
      }
    }
  }
}
