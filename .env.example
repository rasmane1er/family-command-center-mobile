# Copy to .env for local dev, or set as EAS environment variables
# (eas env:create --scope project) for preview/production builds —
# see eas.json for which profile needs which of these.

# Backend API base URL. Falls back to a dev LAN IP if unset — see src/config/api.ts.
EXPO_PUBLIC_API_URL=

# Google Cloud Console → APIs & Services → Credentials → OAuth client IDs.
# All three must be set for Google Sign-In to activate — see SignInScreen.tsx.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat dashboard → Project settings → API keys → SDK API keys.
# Falls back to the shared test/sandbox key if unset — see src/config/revenuecat.ts.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry dashboard → Settings → Client Keys (DSN). Crash reporting is
# disabled (no-op) if unset — see src/config/sentry.ts.
EXPO_PUBLIC_SENTRY_DSN=
